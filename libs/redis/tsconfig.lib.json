{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc/libs/redis",
    "tsBuildInfoFile": "../../dist/out-tsc/libs/redis/tsconfig.lib.tsbuildinfo",
    "rootDir": "src",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["vitest.config.mts", "src/**/*.spec.ts", "src/**/*.test.ts"],
  "references": [
    {
      "path": "../server/tsconfig.lib.json"
    }
  ]
}
