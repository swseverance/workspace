{
  "apphosting": [
    {
      "backendId": "weight-tracker",
      "rootDir": "/apps/weight-tracker",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "functions"
      ]
    },
    {
      "backendId": "chinese-flashcards",
      "rootDir": "/apps/chinese-flashcards",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "functions"
      ]
    },
    {
      "backendId": "ghreactions",
      "rootDir": "/apps/ghreactions",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "functions"
      ],
      "alwaysDeployFromSource": true
    },
    {
      "backendId": "tcpl-exercises",
      "rootDir": "/apps/tcpl-exercises",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "functions"
      ],
      "alwaysDeployFromSource": true
    }
  ],
  "functions": [
    {
      "source": "dist/apps/ghreactions-functions",
      "codebase": "ghreactions",
      "runtime": "nodejs24",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "configDir": "apps/ghreactions-functions"
    }
  ],
  "emulators": {
    "firestore": {
      "port": 8080
    }
  }
}
