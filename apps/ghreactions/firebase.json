{
  "apphosting": {
    "backendId": "ghreactions",
    "rootDir": "/apps/ghreactions",
    "sourceDir": "../..",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "functions",
      ".agents",
      ".claude",
      ".codex",
      ".cursor",
      ".devcontainer",
      ".gemini",
      ".github",
      ".opencode",
      ".vscode"
    ],
    "alwaysDeployFromSource": true
  },
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "apphosting": {
      "startCommand": "npx nx serve ghreactions",
      "port": 4200
    },
    "auth": {}
  }
}
