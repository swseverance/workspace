{
  "name": "chinese-flashcards",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/chinese-flashcards/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/chinese-flashcards",
        "browser": "apps/chinese-flashcards/src/main.ts",
        "tsConfig": "apps/chinese-flashcards/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/chinese-flashcards/public"
          }
        ],
        "styles": [
          "./node_modules/ng-zorro-antd/ng-zorro-antd.min.css",
          "apps/chinese-flashcards/src/styles.scss"
        ],
        "server": "apps/chinese-flashcards/src/main.server.ts",
        "ssr": {
          "entry": "apps/chinese-flashcards/src/server.ts"
        },
        "outputMode": "server",
        "security": {
          "allowedHosts": []
        },
        "externalDependencies": ["firebase-admin"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/chinese-flashcards/src/environments/environment.ts",
              "with": "apps/chinese-flashcards/src/environments/environment.prod.ts"
            }
          ]
        },
        "local": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "local",
      "configurations": {
        "production": {
          "buildTarget": "chinese-flashcards:build:production"
        },
        "local": {
          "buildTarget": "chinese-flashcards:build:local"
        }
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false,
        "buildTarget": "chinese-flashcards:build:local"
      }
    },
    "serve-static": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["build"],
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "chinese-flashcards:build",
        "staticFilePath": "dist/apps/chinese-flashcards/browser",
        "spa": true
      }
    }
  }
}
