{
  "name": "ghreactions-functions",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ghreactions-functions/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "platform": "node",
        "outputPath": "dist/apps/ghreactions-functions",
        "format": ["cjs"],
        "bundle": true,
        "thirdParty": false,
        "main": "apps/ghreactions-functions/src/main.ts",
        "tsConfig": "apps/ghreactions-functions/tsconfig.app.json",
        "generatePackageJson": true,
        "esbuildOptions": {
          "sourcemap": true,
          "outExtension": {
            ".js": ".js"
          }
        }
      },
      "configurations": {
        "production": {
          "esbuildOptions": {
            "sourcemap": false,
            "outExtension": {
              ".js": ".js"
            }
          }
        },
        "local": {
          "deleteOutputPath": false
        }
      }
    },
    "emulate": {
      "continuous": true,
      "command": "nx run ghreactions-functions:build:local && cp apps/ghreactions-functions/.secret.local dist/apps/ghreactions-functions/ && npm exec firebase-tools -- functions:shell --config apps/ghreactions/firebase.json --project ghreactionsdev"
    }
  }
}
