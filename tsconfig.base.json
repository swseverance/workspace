{
  "compilerOptions": {
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@org/source"],
    "noUncheckedSideEffectImports": false,
    "types": ["*"],
    "paths": {
      "@org/environment": ["./libs/environment/src/index.ts"],
      "@org/firebase": ["./libs/firebase/src/index.ts"],
      "@org/window": ["./libs/window/src/index.ts"],
      "@org/theme": ["./libs/theme/src/index.ts"],
      "@org/auth": ["./libs/auth/src/index.ts"],
      "@org/server": ["./libs/server/src/index.ts"],
      "@org/logger": ["./libs/logger/src/index.ts"],
      "@org/ui": ["./libs/ui/src/index.ts"]
    }
  }
}
